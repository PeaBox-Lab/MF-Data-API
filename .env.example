# ---------------------------------------------------------------------------
# MF Data API configuration
# Copy this file to .env and adjust values for local development.
# ---------------------------------------------------------------------------

# Where the SQLite database and raw AMFI snapshots are stored.
MFDATA_DATA_DIR=./data

# Optional explicit database path (overrides MFDATA_DATA_DIR/mfdata.db).
# MFDATA_DB=./data/mfdata.db

# Public site / API branding
MFDATA_TITLE=MF Data API
MFDATA_VERSION=1.0.0

# API behaviour
# Requests allowed per client IP inside the window (0 disables rate limiting).
MFDATA_RATE_LIMIT=120
MFDATA_RATE_WINDOW=60
# Comma-separated list, or * for any origin.
MFDATA_CORS_ORIGINS=*

# Ingestion defaults
MFDATA_BOOTSTRAP_DAYS=1095
MFDATA_INCREMENTAL_DAYS=7
MFDATA_CHUNK_DAYS=30
MFDATA_RAW_RETENTION_DAYS=90
MFDATA_REQUEST_TIMEOUT=120

# Docker only: run a sync automatically when the database does not exist.
MFDATA_AUTO_SYNC=1
